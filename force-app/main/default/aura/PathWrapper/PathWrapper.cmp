<aura:component implements="force:hasRecordId,flexipage:availableForRecordHome" access="global">
    <aura:attribute name="recordId" type="Id" />

    <!-- <lightning:path aura:id="path" recordId="a00C100000C2zdBIAR" variant="non-linear" hideUpdateButton="false" /> -->
    <lightning:path aura:id="path" recordId="{!v.recordId}" variant="{!v.variant}"
        hideUpdateButton="{!v.hideUpdateButton}" onselect="{!c.handleSelect}" />
    <c:mainLwcComponent recordId="a00C100000C2zdBIAR" />
</aura:component>